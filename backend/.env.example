PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/homebites
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional — leave both blank to run in MOCK payment mode (orders "pay"
# instantly with no real gateway, for local dev/demo). Add real Razorpay
# TEST-mode keys (no KYC/activation needed) to exercise the actual checkout:
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Which last-mile logistics adapter to use — only "manual" exists today
# (the vendor manages delivery themselves). See services/deliveryProvider.js.
DELIVERY_PROVIDER=manual
